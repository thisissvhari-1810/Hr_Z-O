# Copy this file to `.env` (same folder) and adjust values for your environment.
# docker-compose will pick these up automatically.

# ---- PostgreSQL ----
POSTGRES_USER=peopleflow
POSTGRES_PASSWORD=peopleflow
POSTGRES_DB=peopleflow

# ---- Backend ----
# Generate a long random string for production.
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Leave blank when the frontend talks to the backend through the nginx proxy
# (the default setup). Only set this if you call the API cross-origin.
CORS_ORIGIN=

# ---- Host port mappings ----
# Change these if the defaults are already in use on your host.
FRONTEND_HOST_PORT=4000
BACKEND_HOST_PORT=5000
