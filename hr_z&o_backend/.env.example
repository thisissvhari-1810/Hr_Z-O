# Copy this file to `.env` and adjust if needed.
# When you run via docker-compose, the compose file already sets these values
# for you; this file is only useful if you run `node src/server.js` directly
# on your machine.

PORT=4000

# Database connection (either a single DATABASE_URL OR the discrete vars).
DATABASE_URL=postgres://peopleflow:peopleflow@localhost:5432/peopleflow
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=peopleflow
# POSTGRES_PASSWORD=peopleflow
# POSTGRES_DB=peopleflow

# Set to "true" only when connecting to a managed Postgres that requires SSL.
DATABASE_URL_SSL=false

# JWT secret — generate something long & random for production.
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: comma-separated list of allowed origins (only needed when the
# frontend talks to the API directly, NOT through the nginx proxy).
# Example: http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=
